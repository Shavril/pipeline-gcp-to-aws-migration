# Copy to .env and adjust as needed (.env is gitignored). Every field below
# is required -- src/oil_pipeline/config.py:Settings has no fallback values,
# so the pipeline won't start without a .env (or these set as real
# environment variables, e.g. in CI).

# Raw RRC extracts (EBCDIC tapes, ~11 GB total) are acquired locally via the
# Selenium workflow in texas-oil-data-platform. To avoid duplicating ~11 GB
# on disk (see CLAUDE.md: the migration boundary starts after local Parquet
# generation), data/raw/{production,operators,organizations,wells} in this
# repo are NTFS directory junctions pointing at the already-acquired files
# in the sibling repo -- the paths below are local, but the bytes live once,
# on disk, in texas-oil-data-platform.
OIL_PIPELINE_RAW_PRODUCTION_PATH=data/raw/production/PDF100.ebc
OIL_PIPELINE_RAW_P4_PATH=data/raw/operators/p4f606.ebc
OIL_PIPELINE_RAW_P5_PATH=data/raw/organizations/orf850.ebc
OIL_PIPELINE_RAW_WELLS_PATH=data/raw/wells/dbf900.ebc

# DuckDB tables and Parquet output are regenerated locally in THIS repo, so
# the AWS-facing steps (S3 upload, Redshift load) start from this repo's own
# local artifacts, not the GCP repo's.
OIL_PIPELINE_OIL_PRODUCTION_DB_PATH=data/database/oil_production.duckdb
OIL_PIPELINE_LEASE_OPERATORS_DB_PATH=data/database/lease_operators.duckdb
OIL_PIPELINE_WELLS_DB_PATH=data/database/wells.duckdb
OIL_PIPELINE_PROCESSED_DATA_PATH=data/processed

# GCP settings kept for now -- src/oil_pipeline/load/gcs.py and
# load/bigquery.py are still the GCP originals until Phase 1/2 replace them
# with S3/Redshift (see CLAUDE.md). Only needed if you run the GCP-facing
# assets/smoke tests from this repo; safe to leave as placeholders otherwise.
OIL_PIPELINE_GCP_PROJECT_ID=texas-oil-data-platform
OIL_PIPELINE_GCS_BUCKET_NAME=texas-oil-data-platform
OIL_PIPELINE_BQ_DATASET=analytics

# Read directly by the dagster CLI (dev/definitions validate/...), not part
# of oil_pipeline.config.Settings. Without it, dagster dev uses a fresh
# temp instance each run and forgets materialization history on restart.
# Must be an absolute path -- adjust to wherever you cloned this repo.
DAGSTER_HOME=C:\path\to\pipeline-gcp-to-aws-migration\.dagster_home
